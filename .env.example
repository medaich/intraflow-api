# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Reverse Proxy Configuration
# TRUST_PROXY: Number of trusted reverse proxy hops in front of the API (integer >= 0).
# Set to 0 if the API is directly exposed or in dev/local (disables trust for X-Forwarded-For).
# Set to the exact number of reverse proxies (e.g. 1 for Nginx/Cloudflare) in production.
TRUST_PROXY=0

# Security & Sessions
# In production, COOKIE_KEY must be >= 32 chars and not use CHANGE_ME_ / secret placeholders.
COOKIE_KEY=CHANGE_ME_super_secret_cookie_signing_key_at_least_32_chars_long
# In production, COOKIE_SECURE defaults to true. Can only be false if APP_URL is localhost / 127.0.0.1.
COOKIE_SECURE=false
TOKEN_EXPIRATION=86400 # in seconds (default: 86400 = 24 hours)

# Database Configuration (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_DATABASE=intraflow
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password

# First Administrator Seed (used on initial bootstrap)
# Required in production if no admin exists; optional in development
ADMIN_EMAIL=admin@intraflow.dev
ADMIN_PASSWORD=CHANGE_ME_admin_password_min_8_chars
ADMIN_NAME=Super Admin

# Mailer Configuration
# Supported transports: smtp, memory (memory is default)
MAIL_TRANSPORT=memory
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Intraflow <noreply@intraflow.dev>
RESET_TOKEN_TTL=3600 # Password reset token TTL in seconds (default: 3600 = 1 hour)
EMAIL_CHANGE_TOKEN_TTL=86400 # Email change token TTL in seconds (default: 86400 = 24 hours)

# Frontend Integration Paths (constants appended to APP_URL in email links)
# Signup: /signup?token=<token>
# Password Reset: /reset-password?token=<token>
# Email Confirmation: /confirm-email?token=<token>

# File Storage Configuration
STORAGE_DIR=./storage
MAX_FILE_SIZE=10485760 # Max file size in bytes (10MB)
MAX_ATTACHMENTS_PER_TASK=20 # Max attachments allowed per task
