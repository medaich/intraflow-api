# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Security & Sessions
COOKIE_KEY=replace_with_a_secure_random_key_in_production
TOKEN_EXPIRATION=86400 # in seconds (default: 86400 = 24 hours)

# Database Configuration (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_DATABASE=intraflow
MYSQL_USERNAME=root
MYSQL_ROOT_PASSWORD=secret

# First Administrator Seed (used on initial bootstrap)
# Required in production; optional in development (seed is skipped if omitted)
ADMIN_EMAIL=admin@intraflow.dev
ADMIN_PASSWORD=AdminPassword123!
ADMIN_NAME=Super Admin
